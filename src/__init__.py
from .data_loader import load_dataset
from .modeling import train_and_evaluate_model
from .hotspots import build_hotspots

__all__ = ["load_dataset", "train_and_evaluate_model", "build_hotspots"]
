import streamlit as st
import folium
from streamlit_folium import st_folium

from config import APP_TITLE, APP_SUBTITLE
from src.data_loader import load_dataset
from src.modeling import train_and_evaluate_model
from src.hotspots import build_hotspots
from src.explainer import explain_risk

st.set_page_config(
    page_title=APP_TITLE,
    page_icon="🛡️",
    layout="wide",
)

st.title(APP_TITLE)
st.caption(APP_SUBTITLE)


@st.cache_resource(show_spinner=False)
def load_project_data():
    df = load_dataset()
    model, metrics = train_and_evaluate_model(df)
    hotspots = build_hotspots(df)
    return df, model, metrics, hotspots


with st.spinner("Loading dataset and training the model..."):
    df, model, metrics, hotspots = load_project_data()

st.markdown("""
This project keeps the original concept — historical accident hotspot prediction — but makes the pipeline more transparent,
reproducible, and honest about limitations. The model is still traditional machine learning, while the LLM feature is a
small explanation layer only.
""")

st.subheader("Model evaluation")
col1, col2, col3, col4, col5 = st.columns(5)
col1.metric("Accuracy", f"{metrics['accuracy']:.3f}")
col2.metric("Precision", f"{metrics['precision']:.3f}")
col3.metric("Recall", f"{metrics['recall']:.3f}")
col4.metric("F1", f"{metrics['f1']:.3f}")
col5.metric("ROC AUC", f"{metrics['roc_auc']:.3f}")

st.caption(
    "The target is a binary high-risk label: major or fatal accidents are treated as the risky class. "
    "This is a historical risk model, not a real-time accident warning system."
)

st.subheader("Hotspot map")
map_center = [df["latitude"].mean(), df["longitude"].mean()]
map_obj = folium.Map(location=map_center, zoom_start=5, tiles="CartoDB positron")

for _, row in hotspots.head(60).iterrows():
    color = "red" if row["risk_level"] == "HIGH" else "orange" if row["risk_level"] == "MEDIUM" else "green"
    folium.CircleMarker(
        location=[row["latitude"], row["longitude"]],
        radius=8,
        color=color,
        fill=True,
        fill_color=color,
        fill_opacity=0.9,
        popup=f"{row['risk_level']} risk — {row['total_accidents']} accidents",
    ).add_to(map_obj)

st_folium(map_obj, width=1200, height=500)

st.subheader("High-risk hotspot summary")
summary_cols = [
    "cluster_id",
    "total_accidents",
    "fatal",
    "casualties",
    "peak_hour",
    "top_cause",
    "risk_level",
    "avg_risk",
]

st.dataframe(hotspots[summary_cols].sort_values("avg_risk", ascending=False).head(10), use_container_width=True)

st.subheader("Risk explanation")
with st.form("risk_form"):
    lat = st.number_input("Latitude", value=13.0827, format="%.6f")
    lon = st.number_input("Longitude", value=80.2707, format="%.6f")
    weather = st.selectbox("Weather", ["clear", "fog", "rain"])
    road_type = st.selectbox("Road type", ["urban", "highway", "rural"])
    hour = st.slider("Hour of day", 0, 23, 18)
    vehicles = st.slider("Vehicles involved", 1, 8, 2)
    risk_score = st.slider("Risk score proxy", 0.0, 1.0, 0.5, step=0.05)
    submitted = st.form_submit_button("Explain risk")

if submitted:
    sample = {
        "latitude": lat,
        "longitude": lon,
        "weather": weather,
        "road_type": road_type,
        "hour": hour,
        "traffic_density": "medium",
        "visibility": "low" if weather in {"fog", "rain"} else "high",
        "is_peak_hour": 1 if hour in range(7, 10) or hour in range(17, 20) else 0,
        "vehicles_involved": vehicles,
        "risk_score": float(risk_score),
        "casualties": 1,
    }
    prob = model.predict_proba([[
        sample["latitude"],
        sample["longitude"],
        sample["hour"],
        {"clear": 0, "fog": 1, "rain": 2}[sample["weather"]],
        {"rural": 0, "urban": 1, "highway": 2}[sample["road_type"]],
        {"low": 0, "medium": 1, "high": 2}[sample["traffic_density"]],
        {"low": 2, "medium": 1, "high": 0}[sample["visibility"]],
        sample["is_peak_hour"],
        sample["vehicles_involved"],
        sample["risk_score"],
    ]])[0][1]
    explanation = explain_risk(sample, prob)
    st.info(explanation)

st.subheader("Implementation notes")
st.markdown(
    """
    - The project uses a traditional machine learning model as the primary decision engine.
    - The map is a historical hotspot visualization, not a live accident warning system.
    - The LLM explanation is intentionally simple and optional.
    - The dataset is sourced from the original project's historical accident dataset and downloaded automatically when not present.
    - Model limitations are documented in the README.
    """
)
