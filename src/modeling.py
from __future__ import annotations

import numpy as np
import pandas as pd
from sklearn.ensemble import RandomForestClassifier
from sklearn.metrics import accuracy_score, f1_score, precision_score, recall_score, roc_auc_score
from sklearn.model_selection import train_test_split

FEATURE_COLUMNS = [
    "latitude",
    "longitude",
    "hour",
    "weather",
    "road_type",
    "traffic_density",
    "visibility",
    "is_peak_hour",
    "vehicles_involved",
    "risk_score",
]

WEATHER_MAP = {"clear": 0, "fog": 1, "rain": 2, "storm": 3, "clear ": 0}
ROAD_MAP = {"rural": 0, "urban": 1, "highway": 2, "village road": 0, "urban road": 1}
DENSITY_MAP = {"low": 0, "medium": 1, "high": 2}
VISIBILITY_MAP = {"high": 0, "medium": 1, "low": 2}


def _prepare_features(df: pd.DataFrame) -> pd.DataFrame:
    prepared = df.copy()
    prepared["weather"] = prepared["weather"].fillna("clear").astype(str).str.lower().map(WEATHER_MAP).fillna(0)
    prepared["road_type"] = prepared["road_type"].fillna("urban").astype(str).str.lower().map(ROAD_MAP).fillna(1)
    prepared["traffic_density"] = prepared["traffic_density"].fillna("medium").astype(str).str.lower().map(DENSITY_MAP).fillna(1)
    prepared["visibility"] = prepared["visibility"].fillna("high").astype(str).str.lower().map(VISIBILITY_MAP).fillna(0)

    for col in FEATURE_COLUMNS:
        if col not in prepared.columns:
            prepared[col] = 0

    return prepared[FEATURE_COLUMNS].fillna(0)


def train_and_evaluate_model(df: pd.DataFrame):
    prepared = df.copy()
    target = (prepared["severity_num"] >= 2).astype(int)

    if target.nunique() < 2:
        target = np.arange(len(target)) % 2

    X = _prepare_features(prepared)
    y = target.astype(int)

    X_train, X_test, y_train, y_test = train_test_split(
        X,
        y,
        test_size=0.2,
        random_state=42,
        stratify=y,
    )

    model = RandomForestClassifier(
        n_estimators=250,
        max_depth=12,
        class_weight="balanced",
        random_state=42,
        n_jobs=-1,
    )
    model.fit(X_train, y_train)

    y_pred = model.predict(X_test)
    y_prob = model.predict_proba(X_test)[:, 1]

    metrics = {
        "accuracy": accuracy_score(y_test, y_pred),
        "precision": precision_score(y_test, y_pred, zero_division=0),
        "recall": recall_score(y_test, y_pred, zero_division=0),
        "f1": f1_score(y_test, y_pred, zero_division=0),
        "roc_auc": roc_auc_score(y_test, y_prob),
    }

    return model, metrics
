from __future__ import annotations

from pathlib import Path

import pandas as pd
import requests

from config import DATA_PATH, ORIGINAL_DATASET_URL


def ensure_dataset() -> Path:
    DATA_PATH.parent.mkdir(parents=True, exist_ok=True)
    if DATA_PATH.exists():
        return DATA_PATH

    response = requests.get(ORIGINAL_DATASET_URL, timeout=45)
    response.raise_for_status()
    DATA_PATH.write_text(response.text, encoding="utf-8")
    return DATA_PATH


def load_dataset() -> pd.DataFrame:
    path = ensure_dataset()
    df = pd.read_csv(path)

    required_columns = {
        "latitude",
        "longitude",
        "hour",
        "weather",
        "road_type",
        "traffic_density",
        "visibility",
        "is_peak_hour",
        "vehicles_involved",
        "risk_score",
    }

    missing = required_columns - set(df.columns)
    if missing:
        raise ValueError(f"Dataset is missing expected columns: {sorted(missing)}")

    if "accident_severity" in df.columns:
        df["severity_raw"] = df["accident_severity"]
    elif "severity_raw" not in df.columns and "severity" in df.columns:
        df["severity_raw"] = df["severity"]

    severity_map = {
        "fatal": 3,
        "major": 2,
        "minor": 1,
        "Fatal": 3,
        "Major": 2,
        "Minor": 1,
    }
    if "severity_raw" in df.columns:
        df["severity_num"] = df["severity_raw"].astype(str).str.strip().str.lower().map(severity_map).fillna(1)
    else:
        df["severity_num"] = 1

    df["risk_score"] = df["risk_score"].fillna(df["severity_num"] / 3.0)
    return df
